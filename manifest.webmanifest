{
  "name": "Marginalia",
  "short_name": "Marginalia",
  "description": "Highlight PDFs, anchor notes to passages, and let the margins grow to fit what you write.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#E3E7ED",
  "theme_color": "#F5F6F8",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/pdf": [".pdf"] } }
  ]
}
